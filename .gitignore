# --- credentials: never commit ---
.env
.env.*
*.pem
*.key
**/secrets.yaml
**/credentials.json

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# --- generated run artefacts (regenerated by the starter harness) ---
results/*
!results/.gitkeep
*_results.json
*.log
cache/

# NOTE: nsc-starter/data/*.json IS tracked — it is the course benchmark panel,
# not a generated artefact. nsc-starter/expected_development.json is the
# supplied reference output and is tracked too.
#
# figures/ and tables/ ARE tracked: the report figures and tables are
# deliverables, regenerated by experiments/plot_figures.py and
# experiments/make_tables.py. Regenerate them rather than editing by hand.

# --- local reference material (proposal PDF, starter zip): ignored as a folder ---
reference/

# --- editors / OS ---
.DS_Store
.vscode/
.idea/
