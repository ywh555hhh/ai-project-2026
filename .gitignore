# --- credentials: never commit ---
.env
.env.*
*.pem
*.key
**/secrets.yaml
**/credentials.json

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

